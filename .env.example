# Copy to .env and change every value marked CHANGE. Never commit .env.

# A long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-me
DJANGO_DEBUG=false
# Names and addresses the hub is reached by: add the VM's IP address.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed behind a reverse proxy, e.g. https://hub.example.lan
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Dublin

POSTGRES_DB=wallhub
POSTGRES_USER=wallhub
POSTGRES_PASSWORD=CHANGE-me

# Pre-filled in the scan form, e.g. 192.168.1.0/24
WALL_DEFAULT_TARGETS=
WALL_SCAN_TIMEOUT_S=600
WALL_HUB_PORT=8000

# Monitoring of devices marked "monitored".
WALL_HEALTHCHECK_INTERVAL_S=60
# Consecutive failed checks before a device counts as down and an alert is sent.
WALL_ALERT_AFTER_FAILURES=2
# Who gets alert emails, comma-separated. Empty: alerts are only shown in the hub.
WALL_ALERT_EMAILS=
# The hub's address, for links in alert emails, e.g. http://192.168.1.10:8000
WALL_HUB_URL=

# Outgoing mail (SMTP). Empty EMAIL_HOST: emails are printed to the worker log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=wall-hub@example.com
