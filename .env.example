# Copy to .env and change every value marked CHANGE. Never commit .env.

# A long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-me
DJANGO_DEBUG=false
# Names and addresses the hub is reached by: add the VM's IP address.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed behind a reverse proxy, e.g. https://hub.example.lan
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Dublin

POSTGRES_DB=wallhub
POSTGRES_USER=wallhub
POSTGRES_PASSWORD=CHANGE-me

# Pre-filled in the scan form, e.g. 192.168.1.0/24
WALL_DEFAULT_TARGETS=
WALL_SCAN_TIMEOUT_S=600
WALL_HUB_PORT=8000

# Automatic scans of the networks the VM is attached to (wall-scan --local).
# Off by default: they scan whatever network the VM is plugged into.
# Discovery sweep every N minutes (0: off), e.g. 60:
WALL_AUTO_SCAN_INTERVAL_MIN=0
# Full port scan every day at HH:30 (empty: off), e.g. 2:
WALL_AUTO_PORT_SCAN_HOUR=
# Interfaces whose networks are never scanned, comma-separated,
# e.g. enp0s3 for VirtualBox's NAT network on the lab VM:
WALL_SCAN_EXCLUDE_INTERFACES=
# Email when a scan finds a device for the first time (not on the first scan).
WALL_ALERT_NEW_DEVICES=true

# SNMP details of printers and network equipment (wall-snmpinfo).
# The community string of your devices (often "public"); passed to the tool
# through the environment, never on a command line.
WALL_SNMP_COMMUNITY=public
# Read them every N hours (0: only with "Read now" on the device page).
WALL_SNMP_INTERVAL_H=6
# Email once when a supply drops below this percentage, again after a refill.
WALL_TONER_ALERT_PERCENT=10

# Wake-on-LAN (wall-wol). The packets go to the broadcast address of the network
# a scan found the device on; this address is used when no scan covered it.
WALL_WOL_BROADCAST=255.255.255.255
# After sending, check for up to N seconds whether the device answers (0: don't).
WALL_WOL_WAIT_S=180

# Monitoring of devices marked "monitored".
WALL_HEALTHCHECK_INTERVAL_S=60
# Consecutive failed checks before a device counts as down and an alert is sent.
WALL_ALERT_AFTER_FAILURES=2
# Who gets alert emails, comma-separated. Empty: alerts are only shown in the hub.
WALL_ALERT_EMAILS=
# The hub's address, for links in alert emails, e.g. http://192.168.1.10:8000
WALL_HUB_URL=
# Warranty and licence reminder emails: days before the date (0 = on the day),
# and the hour they are sent (in TIME_ZONE). Same recipients as alerts.
WALL_EXPIRY_REMINDER_DAYS=30,7,1,0
WALL_EXPIRY_REMINDER_HOUR=8

# Outgoing mail (SMTP). Empty EMAIL_HOST: emails are printed to the worker log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=wall-hub@example.com
